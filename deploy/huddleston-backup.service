[Unit]
Description=Back up Huddleston Science PostgreSQL
After=postgresql.service

[Service]
Type=oneshot
User=huddleston
Group=huddleston
WorkingDirectory=/srv/huddleston/current
EnvironmentFile=/etc/huddleston/site.env
Environment=DJANGO_ENV_FILE=/etc/huddleston/site.env
ExecStart=/srv/huddleston/current/.venv/bin/python manage.py backup_database /var/backups/huddleston
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/huddleston
