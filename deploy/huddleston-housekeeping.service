[Unit]
Description=Remove expired sessions and login throttle buckets
After=postgresql.service

[Service]
Type=oneshot
User=huddleston
Group=huddleston
WorkingDirectory=/srv/huddleston/current
EnvironmentFile=/etc/huddleston/site.env
Environment=DJANGO_ENV_FILE=/etc/huddleston/site.env
ExecStart=/srv/huddleston/current/.venv/bin/python manage.py clearsessions
ExecStart=/srv/huddleston/current/.venv/bin/python manage.py purge_login_buckets
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
