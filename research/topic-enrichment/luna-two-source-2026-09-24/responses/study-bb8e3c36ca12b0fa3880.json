            "text": "{\n  \"study_topic_id\": \"study-bb8e3c36ca12b0fa3880\",\n  \"overview\": {\n    \"text\": \"Baseball is a bat-and-ball team sport played on a field. In Major League Baseball’s rules, two teams of nine players take turns on offense and defense: the batter tries to become a runner, while fielders try to stop runners advancing. A runner scores by legally touching first, second, third, and home; the team with more runs wins. A regulation MLB game is nine innings, though ties can extend play and games may be shortened in specified situations. Baseball’s rules took shape gradually: New York clubs used differing rules in the 1850s, and a 1857 convention produced a shared rulebook. The game’s history and cultural influence are closely connected with American life, but the story that Abner Doubleday invented baseball in Cooperstown in 1839 is a legend, not an established account.\",\n    \"source_urls\": [\n      \"https://content.mlb.com/documents/2/2/4/305750224/2019_Official_Baseball_Rules_FINAL_.pdf\",\n      \"https://baseballhall.org/rules-of-base-ball\",\n      \"https://baseballhall.org/media/museum-history\"\n    ]\n  },\n  \"key_facts\": [\n    {\n      \"text\": \"In MLB rules, a runner scores by touching first, second, third, and home in order.\",\n      \"source_urls\": [\n        \"https://content.mlb.com/documents/2/2/4/305750224/2019_Official_Baseball_Rules_FINAL_.pdf\"\n      ]\n    },\n    {\n      \"text\": \"MLB’s rulebook specifies nine players per team and nine innings for a regulation game, with exceptions.\",\n      \"source_urls\": [\n        \"https://content.mlb.com/documents/2/2/4/305750224/2019_Official_Baseball_Rules_FINAL_.pdf\"\n      ]\n    },\n    {\n      \"text\": \"New York clubs had differing rules in the 1850s; a convention in 1857 adopted a shared rulebook.\",\n      \"source_urls\": [\n        \"https://baseballhall.org/rules-of-base-ball\"\n      ]\n    },\n    {\n      \"text\": \"The Cooperstown story crediting Abner Doubleday with baseball’s invention in 1839 is described as legendary, not established history.\",\n      \"source_urls\": [\n        \"https://baseballhall.org/media/museum-history\"\n      ]\n    },\n    {\n      \"text\": \"The Baseball Hall of Fame describes baseball as reflecting and influencing aspects of American life and culture.\",\n      \"source_urls\": [\n        \"https://baseballhall.org/rules-of-base-ball\"\n      ]\n    }\n  ],\n  \"sources\": [\n    {\n      \"title\": \"2019 Official Baseball Rules\",\n      \"url\": \"https://content.mlb.com/documents/2/2/4/305750224/2019_Official_Baseball_Rules_FINAL_.pdf\",\n      \"publisher\": \"Major League Baseball\",\n      \"retrieved_at\": \"2026-09-24T18:53:39.634945+00:00\",\n      \"supports\": \"Defines MLB’s team objective, scoring by touching the bases in order, nine players per team, and the standard nine-inning regulation game and exceptions.\"\n    },\n    {\n      \"title\": \"The Rules of Base Ball\",\n      \"url\": \"https://baseballhall.org/rules-of-base-ball\",\n      \"publisher\": \"National Baseball Hall of Fame and Museum\",\n      \"retrieved_at\": \"2026-09-24T18:53:39.634945+00:00\",\n      \"supports\": \"Describes differing club rules in the 1850s, the 1857 convention and shared rulebook, and baseball’s relationship to American culture.\"\n    },\n    {\n      \"title\": \"Museum History\",\n      \"url\": \"https://baseballhall.org/media/museum-history\",\n      \"publisher\": \"National Baseball Hall of Fame and Museum\",\n      \"retrieved_at\": \"2026-09-24T18:53:39.634945+00:00\",\n      \"supports\": \"Explains that the Doubleday invention account was a legend associated with Cooperstown’s 1839 origin story.\"\n    }\n  ],\n  \"research_queries\": [\n    \"site:baseballhall.org baseball history origins rules bases nine innings\",\n    \"site:mlb.com official baseball rules objective innings bases runs\",\n    \"site:loc.gov baseball history sport evolution\"\n  ],\n  \"notes\": \"Overview length: 119 words. The rules source is MLB-specific; the nine-player and nine-inning details should not be assumed to describe every youth league or baseball variant.\",\n  \"unresolved_concerns\": [\n    \"The MLB rules source opened and read is the 2019 edition; rules and formats in other leagues or levels may differ.\"\n  ],\n  \"self_check_complete\": true\n}"
