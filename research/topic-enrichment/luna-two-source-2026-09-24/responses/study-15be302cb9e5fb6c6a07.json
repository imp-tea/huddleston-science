    "input": "{\"current_utc\": \"2026-09-24T18:47:31.508701+00:00\", \"assigned_topic\": {\"study_topic_id\": \"study-15be302cb9e5fb6c6a07\", \"subject_id\": \"subject-d6b76dbe645f949db1f7\", \"topic\": \"Sodium\", \"primary_category\": \"Science and Technology\", \"description\": \"Sodium is the reactive alkali metal with atomic number 11, known for its bright-yellow flame test and compounds such as sodium chloride, sodium carbonate, sodium bicarbonate, and sodium hydroxide.\", \"subcategory_ids\": [\"science-013\"], \"level_occurrence_counts\": {\"high-school\": 2}, \"role_occurrence_counts\": {\"answer\": 2}, \"source_question_count\": 2, \"aliases\": [\"Na\", \"Natrium\", \"Atomic Number 11\"], \"topic_type\": \"substance\", \"source_ids\": [\"qb-9aaf5217084b95aaa6d9fa8d\", \"qb-4872c03babacc6609a1ed619\"], \"source_questions\": [{\"custom_id\": \"qb-9aaf5217084b95aaa6d9fa8d\", \"level\": \"high-school\", \"question_type\": \"tossups\", \"source\": \"2020 TAILS\", \"round\": \"7\", \"number\": \"2\", \"parts\": [{\"label\": \"tossup\", \"question\": \"The Downs process produces this element, which also names a “doublet” found in Fraunhofer (FROWN-hoh-fur) lines. This second-lightest alkali metal produces an intense yellow color in a flame test. This element’s carbonate is called soda ash, while its bicarbonate is known as baking soda. High concentrations of this element and (*) chlorine make ocean water undrinkable. For ten points, name this element with symbol Na, which binds with chlorine to make table salt.\", \"answer\": \"sodium [accept Na]\"}]}, {\"custom_id\": \"qb-4872c03babacc6609a1ed619\", \"level\": \"high-school\", \"question_type\": \"bonuses\", \"source\": \"2022 KICKOFF Novice\", \"round\": \"9\", \"number\": \"1\", \"parts\": [{\"label\": \"L\", \"question\": \"Answer some questions about the flame test. For 10 points each:\", \"answer\": \"\"}, {\"label\": \"A\", \"question\": \"[M] The flame test commonly uses this apparatus to provide a flame. This apparatus, named for a German chemist, is also used to sterilize loops in microbiology.\", \"answer\": \"Bunsen burner\"}, {\"label\": \"B\", \"question\": \"[E] This element’s halides produce a green or blue-green frame. This metal is commonly used in wires because of its low cost and high conductivity.\", \"answer\": \"copper [or Cu]\"}, {\"label\": \"C\", \"question\": \"[H] This alkali metal produces a bright-yellow flame. This element’s hydroxide forms a strong base called lye.\", \"answer\": \"sodium [or Na]\"}]}]}}",
