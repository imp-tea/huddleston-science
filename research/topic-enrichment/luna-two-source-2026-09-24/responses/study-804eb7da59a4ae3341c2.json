    "input": "{\"current_utc\": \"2026-09-24T18:36:09.172281+00:00\", \"assigned_topic\": {\"study_topic_id\": \"study-804eb7da59a4ae3341c2\", \"subject_id\": \"subject-0ca9f174bf5d3bc01e3a\", \"topic\": \"Arles\", \"primary_category\": \"Geography\", \"description\": \"A city in Provence, southern France, located along the Rhône River and historically associated with Roman heritage and Vincent van Gogh.\", \"subcategory_ids\": [\"geo-018\", \"geo-006\"], \"level_occurrence_counts\": {\"high-school\": 2}, \"role_occurrence_counts\": {\"answer\": 2}, \"source_question_count\": 2, \"aliases\": [\"Arelate\"], \"topic_type\": \"place\", \"source_ids\": [\"qb-b679108e8980a453dadcd330\", \"qb-efc5238d7fb1201b8348ae87\"], \"source_questions\": [{\"custom_id\": \"qb-b679108e8980a453dadcd330\", \"level\": \"high-school\", \"question_type\": \"bonuses\", \"source\": \"2022 KICKOFF Novice\", \"round\": \"3\", \"number\": \"18\", \"parts\": [{\"label\": \"L\", \"question\": \"This painting’s artist also made a painting titled for it “over the Rhone.\\\" For 10 points each:\", \"answer\": \"\"}, {\"label\": \"A\", \"question\": \"[M] Name this painting, in which a large cypress tree appears in its foreground. Swirling yellow brushstrokes were used to depict objects in the sky in this painting, completed while its artist stayed in an asylum in Saint-Remy.\", \"answer\": \"The Starry Night [or Starry Night over the Rhone; or La Nuit etoilee; accept De sterrennacht]\"}, {\"label\": \"B\", \"question\": \"[E] The Starry Night and Starry Night over the Rhone were both painted by this Dutch artist, who is also known for painting sunflowers.\", \"answer\": \"Vincent van Gogh\"}, {\"label\": \"C\", \"question\": \"[H] Starry Night over the Rhone depicts the title river flowing through this French city, where Van Gogh lived. Van Gogh painted the blue walls of the title room in a painting titled Bedroom in [this city].\", \"answer\": \"Arles [or Bedroom in Arles; or La Chambre a Arles]\"}]}, {\"custom_id\": \"qb-efc5238d7fb1201b8348ae87\", \"level\": \"high-school\", \"question_type\": \"bonuses\", \"source\": \"2022 IQBT Regular Season Set 1\", \"round\": \"10\", \"number\": \"12\", \"parts\": [{\"label\": \"L\", \"question\": \"This river's valley is the home of “Papal wine,” descended from the 14th-century estate of John XXII  (the twenty-second). For 10 points each:\", \"answer\": \"\"}, {\"label\": \"A\", \"question\": \"Name this river of southeastern France that flows through Avignon (AA-veen-yohn) and into  southern Switzerland before draining Lake Geneva and meeting the Saône (SUH-nuh) at Lyon (LEE-on).\", \"answer\": \"Rhône (hroan) River\"}, {\"label\": \"B\", \"question\": \"Near this city, the Rhône divides into the Great and Little Rhône near its mouth. Many sites in this  city are named for Vincent Van Gogh, who made 300 paintings here from 1888 to 1889.\", \"answer\": \"Arles (arl)\"}, {\"label\": \"C\", \"question\": \"The Rhône is the only major European river discharging directly into this large body of water,  which separates Europe from Africa.\", \"answer\": \"Mediterranean Sea\"}]}]}}",
